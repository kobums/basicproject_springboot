# 로컬 전용 설정 예시. 복사해서 application-local.yml 로 만들어 사용한다 (.gitignore 처리됨).
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
spring:
  datasource:
    url: jdbc:mariadb://localhost:3306/project
    username: project
    password: <your-db-password>

app:
  jwt:
    # 32바이트 이상의 랜덤 문자열 (예: openssl rand -base64 48)
    secret: <change-me-to-a-random-secret-at-least-32-bytes>
